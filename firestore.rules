rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function bounded(s,n) { return s is string && s.size() <= n; }
  function dates(d) { return d.createdAt is timestamp && d.updatedAt is timestamp; }
  function immutableCreated() { return request.resource.data.createdAt == resource.data.createdAt; }
  function noteExists(uid,id) { return exists(/databases/$(database)/documents/noteoUsers/$(uid)/notes/$(id)); }
  match /noteoUsers/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['displayName','createdAt','updatedAt','settings']) && bounded(request.resource.data.displayName,200) && dates(request.resource.data) && request.resource.data.settings is map;
   match /notebooks/{id} {
    function valid() { let d=request.resource.data; return d.keys().hasOnly(['name','color','createdAt','updatedAt']) && bounded(d.name,80) && d.name.size()>0 && bounded(d.color,30) && dates(d); }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && valid();
    allow update: if owner(uid) && valid() && immutableCreated();
   }
   match /tags/{id} {
    function valid() { let d=request.resource.data; return d.keys().hasOnly(['name','normalizedName','createdAt','updatedAt']) && bounded(d.name,80) && d.name.size()>0 && bounded(d.normalizedName,100) && dates(d); }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && valid();
    allow update: if owner(uid) && valid() && immutableCreated();
   }
   match /notes/{id} {
    function valid() { let d=request.resource.data; return d.keys().hasOnly(['title','notebookId','tagIds','contentJson','plainText','excerpt','isFavorite','deletedAt','createdAt','updatedAt','lastEditorDeviceId','schemaVersion']) && bounded(d.title,200) && bounded(d.notebookId,100) && exists(/databases/$(database)/documents/noteoUsers/$(uid)/notebooks/$(d.notebookId)) && d.tagIds is list && d.tagIds.size()<=30 && bounded(d.contentJson,512000) && bounded(d.plainText,200000) && bounded(d.excerpt,160) && d.isFavorite is bool && (d.deletedAt==null || d.deletedAt is number) && dates(d) && bounded(d.lastEditorDeviceId,100) && d.schemaVersion==1; }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && valid();
    allow update: if owner(uid) && valid() && immutableCreated();
   }
   match /tasks/{id} {
    function valid() { let d=request.resource.data; return d.keys().hasOnly(['noteId','title','completed','dueAt','createdAt','updatedAt']) && bounded(d.noteId,100) && noteExists(uid,d.noteId) && bounded(d.title,200) && d.title.size()>0 && d.completed is bool && (d.dueAt==null || (d.dueAt is string && d.dueAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) && dates(d); }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && valid();
    allow update: if owner(uid) && valid() && immutableCreated();
   }
   match /attachments/{id} {
    function valid() { let d=request.resource.data; return d.keys().hasOnly(['noteId','storagePath','originalName','mimeType','size','createdAt','status']) && bounded(d.noteId,100) && noteExists(uid,d.noteId) && bounded(d.storagePath,1000) && d.storagePath.matches('^noteo/'+uid+'/'+d.noteId+'/'+id+'/[^/]+$') && bounded(d.originalName,255) && d.mimeType in ['image/jpeg','image/png','image/webp','image/gif','application/pdf','text/plain'] && d.size is number && d.size>0 && d.size<=10485760 && d.createdAt is timestamp && d.status in ['uploading','ready']; }
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && valid();
    allow update: if owner(uid) && valid() && immutableCreated();
   }
  }
 }
}
