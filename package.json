{
  "name": "noteo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-noteo --only firestore,storage 'vitest run --config vitest.rules.config.ts'"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.10.0",
    "@tiptap/extension-task-item": "^3.10.0",
    "@tiptap/extension-task-list": "^3.10.0",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
